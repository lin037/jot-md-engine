{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@jot-md/editor-protocol": ["./packages/editor-protocol/src/index.ts"],
      "@jot-md/editor": ["./packages/editor/src/index.ts"],
      "@jot-md/editor/adapter": ["./packages/editor/src/adapter/index.ts"],
      "@jot-md/editor/component": ["./packages/editor/src/component/index.ts"],
      "@jot-md/editor/commands": ["./packages/editor/src/core/commands/index.ts"],
      "@jot-md/editor/table": ["./packages/editor/src/components/table/public.ts"],
      "@jot-md/editor/toolbar": ["./packages/editor/src/plugins/toolbar.ts"],
      "@jot-md/editor/source": ["./packages/editor/src/hosts/source/index.ts"],
      "@jot-md/editor/observability": ["./packages/editor/src/observability/index.ts"],
      "@jot-md/editor/preview": ["./packages/editor/src/hosts/preview/index.ts"],
      "@jot-md/editor/render": ["./packages/editor/src/render/index.ts"],
      "@jot-md/editor/worker": ["./packages/editor/src/worker/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src/**/*.ts"]
}
