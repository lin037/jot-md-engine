{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@jot-md/editor-protocol": ["./packages/editor-protocol/src/index.ts"],
      "@lin037/jot-md-engine": ["./packages/editor/src/index.ts"],
      "@lin037/jot-md-engine/adapter": ["./packages/editor/src/adapter/index.ts"],
      "@lin037/jot-md-engine/component": ["./packages/editor/src/component/index.ts"],
      "@lin037/jot-md-engine/commands": ["./packages/editor/src/core/commands/index.ts"],
      "@lin037/jot-md-engine/table": ["./packages/editor/src/components/table/public.ts"],
      "@lin037/jot-md-engine/toolbar": ["./packages/editor/src/plugins/toolbar.ts"],
      "@lin037/jot-md-engine/outline": ["./packages/editor/src/plugins/outline.ts"],
      "@lin037/jot-md-engine/source": ["./packages/editor/src/hosts/source/index.ts"],
      "@lin037/jot-md-engine/observability": ["./packages/editor/src/observability/index.ts"],
      "@lin037/jot-md-engine/preview": ["./packages/editor/src/hosts/preview/index.ts"],
      "@lin037/jot-md-engine/render": ["./packages/editor/src/render/index.ts"],
      "@lin037/jot-md-engine/worker": ["./packages/editor/src/worker/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src/**/*.ts"]
}
