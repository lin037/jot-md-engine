# Dependencies and package-manager caches
**/node_modules/
/.pnpm-store/

# Rust, TypeScript, Vite, and package build output
/target/
/dist/
/packages/*/dist/
*.tsbuildinfo
.vite/
.cache/

# Generated WebAssembly bindings
*.wasm
*.wasm.map
/apps/demo/src/generated/
/benchmarks/src/generated/
/packages/editor-protocol/src/index.js*
/packages/editor-protocol/src/index.d.ts*

# Temporary files and test coverage
/.tmp/
coverage/
.nyc_output/

# Local environment settings; keep shareable templates
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Runtime and package-manager logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor files (shared .vscode settings remain versioned)
.idea/
*.swp
*.swo
*~

# macOS and Windows metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# 原始调研、历史设计稿和本机排查记录
/docs/_local/

# 独立的本地桌面应用
/jot-desktop/
